{
  "version": 2,
  "builds": [
    { "src": "**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/$", "dest": "/index.html" },
    { "src": "/download$", "dest": "/download.html" },
    { "src": "/download.html", "dest": "/download.html" },
    { "src": "/templates/(.*)", "dest": "/templates/$1" }
  ]
}
